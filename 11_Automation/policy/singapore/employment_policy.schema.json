{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-os.local/policy/singapore/employment_policy.schema.json",
  "title": "Career_OS Singapore Employment Policy Package v1.0",
  "type": "object",
  "required": ["package_version", "jurisdiction", "last_verified_at", "records"],
  "properties": {
    "package_version": {"type": "string"},
    "jurisdiction": {"const": "Singapore"},
    "last_verified_at": {"type": "string", "format": "date"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "policy_id", "policy_version", "policy_type", "source_authority", "source_url",
          "effective_from", "effective_to", "last_verified_at", "notes"
        ],
        "properties": {
          "policy_id": {"type": "string"},
          "policy_version": {"type": "string"},
          "policy_type": {"type": "string"},
          "source_authority": {"type": "string"},
          "source_url": {"type": "string"},
          "effective_from": {"type": ["string", "null"]},
          "effective_to": {"type": ["string", "null"]},
          "last_verified_at": {"type": "string", "format": "date"},
          "notes": {"type": ["string", "array"]}
        }
      }
    }
  }
}
