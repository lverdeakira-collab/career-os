{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-os.local/schemas/raw_job.schema.json",
  "title": "Career_OS Stage 4 Raw Job Record v0.1",
  "type": "object",
  "required": [
    "schema_version", "raw_record_id", "run_id", "source_connector", "source_category", "source",
    "source_url", "source_api_url", "source_job_id", "requisition_id", "company", "job_title",
    "location_raw", "posting_date_raw", "employment_type_raw", "seniority_raw", "department_raw",
    "job_description_raw", "job_description_html_raw", "application_link_raw", "retrieved_at",
    "source_metadata", "source_payload_sha256", "source_payload", "retrieval_status",
    "validation_replay", "career_os_job_id"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "raw_record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^DISCOVERY-[0-9]{8}-[0-9]{6}$"},
    "source_connector": {"enum": ["lever", "greenhouse", "ashby"]},
    "source_category": {"const": "Public ATS job pages"},
    "source": {"type": "string"},
    "source_url": {"type": ["string", "null"]},
    "source_api_url": {"type": "string"},
    "source_job_id": {"type": "string"},
    "requisition_id": {"type": ["string", "number", "null"]},
    "company": {"type": "string", "minLength": 1},
    "job_title": {"type": "string", "minLength": 1},
    "location_raw": {"type": ["string", "null"]},
    "posting_date_raw": {"type": ["string", "number", "null"]},
    "employment_type_raw": {"type": ["string", "null"]},
    "seniority_raw": {"type": ["string", "null"]},
    "department_raw": {"type": ["string", "null"]},
    "job_description_raw": {"type": "string", "minLength": 1},
    "job_description_html_raw": {"type": ["string", "null"]},
    "application_link_raw": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string"},
    "source_metadata": {"type": "object"},
    "source_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_payload": {"type": "object"},
    "retrieval_status": {"const": "SUCCESS"},
    "validation_replay": {"type": "boolean"},
    "career_os_job_id": {"type": "string", "pattern": "^JOB-[0-9]{8}-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"}
  },
  "additionalProperties": false
}
