{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-os.local/schemas/application.schema.json",
  "title": "Career_OS Canonical Application Schema v0.1",
  "type": "object",
  "required": [
    "Schema_Version", "Application_ID", "Job_ID", "Company", "Role_Title", "Career_Direction",
    "Base_Resume_Version", "Base_Resume_Variant", "Derived_Resume_Path", "Cover_Letter_Path",
    "Application_Date", "Application_Source", "Fit_Score_At_Application", "Decision_At_Application",
    "Application_Status", "Recruiter_Screen", "Interview_1", "Interview_2", "Final_Interview",
    "Offer", "Rejected", "Withdrawn", "Last_Status_Date", "Follow_Up_Date", "Outcome",
    "Outcome_Reason", "User_Notes", "Consent_Approved_By_User", "Created_At", "Updated_At"
  ],
  "properties": {
    "Schema_Version": {"const": "0.1"},
    "Application_ID": {"type": "string", "pattern": "^APP-[0-9]{8}-[0-9]{4}$"},
    "Job_ID": {"type": "string", "pattern": "^JOB-[0-9]{8}-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"},
    "Company": {"type": "string", "minLength": 1},
    "Role_Title": {"type": "string", "minLength": 1},
    "Career_Direction": {"enum": ["Commercial / Research", "Corporate Finance / Transaction / Advisory", "Markets / FMI / FinTech"]},
    "Base_Resume_Version": {"const": "Production Base v1.0"},
    "Base_Resume_Variant": {"enum": ["COMMERCIAL_PRIMARY", "CF_TRANSACTION_SECONDARY"]},
    "Derived_Resume_Path": {"type": ["string", "null"]},
    "Cover_Letter_Path": {"type": ["string", "null"]},
    "Application_Date": {"type": ["string", "null"], "format": "date"},
    "Application_Source": {"type": ["string", "null"]},
    "Fit_Score_At_Application": {"type": "integer", "minimum": 0, "maximum": 100},
    "Decision_At_Application": {"enum": ["PRIORITY_APPLY", "APPLY", "REVIEW"]},
    "Application_Status": {"enum": ["NOT_APPLIED", "APPROVED_FOR_APPLICATION", "MATERIALS_GENERATED", "READY_TO_SUBMIT", "SUBMITTED", "RECRUITER_SCREEN", "INTERVIEW", "FINAL_INTERVIEW", "OFFER", "REJECTED", "WITHDRAWN", "CLOSED"]},
    "Recruiter_Screen": {"type": ["string", "null"]},
    "Interview_1": {"type": ["string", "null"]},
    "Interview_2": {"type": ["string", "null"]},
    "Final_Interview": {"type": ["string", "null"]},
    "Offer": {"type": ["boolean", "null"]},
    "Rejected": {"type": ["boolean", "null"]},
    "Withdrawn": {"type": ["boolean", "null"]},
    "Last_Status_Date": {"type": ["string", "null"], "format": "date"},
    "Follow_Up_Date": {"type": ["string", "null"], "format": "date"},
    "Outcome": {"type": ["string", "null"]},
    "Outcome_Reason": {"type": ["string", "null"]},
    "User_Notes": {"type": ["string", "null"]},
    "Consent_Approved_By_User": {"const": true},
    "Created_At": {"type": "string"},
    "Updated_At": {"type": "string"}
  },
  "additionalProperties": false
}
